# Optional. Use a GitHub token with read access to the repositories you track.
GH_TOKEN=
# FOGGY_PORT=4173
# FOGGY_DATA_DIR=/absolute/path/to/data
# FOGGY_POLL_INTERVAL_MS=60000

# Optional legacy default-workspace sync target. Additional targets use workspace create/connect.
# Cloud workspaces remain local SQLite graphs; sync preview/apply is manual.
# Use only a selected PRIVATE state repository and an existing branch.
# Dedicated mode (default): Contents read/write; no automatic GH_TOKEN fallback.
# Explicit workspace --credential github reuses server GH_TOKEN/GITHUB_TOKEN/gh auth token.
# Reused credentials need Contents read/write on the selected PRIVATE state repository.
# Create/connect save configuration only, without remote reads or writes.
# Replace placeholders locally in ignored .env; never commit credentials.
# FOGGY_SYNC_REPO=OWNER/PRIVATE_STATE_REPO
# FOGGY_SYNC_BRANCH=main
# FOGGY_SYNC_PATH=foggybrain/state.json
# FOGGY_SYNC_TOKEN=REPLACE_LOCALLY_WITH_DEDICATED_TOKEN

# CLI selection must be exported in its process environment; CLI does not load .env.
# FOGGY_WORKSPACE=WORKSPACE_ID
# Up to 3 entries; existing database is workspace default. Tabs select independently.
