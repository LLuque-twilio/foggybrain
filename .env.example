# Optional. Use a GitHub token with read access to the repositories you track.
GH_TOKEN=
# FOGGY_PORT=4173
# FOGGY_DATA_DIR=/absolute/path/to/data
# FOGGY_POLL_INTERVAL_MS=60000

# Optional manual state sync. Leave ALL sync variables unset to disable.
# Use only a selected PRIVATE state repository and an existing branch.
# Dedicated fine-grained token: Contents read/write; no GH_TOKEN fallback.
# Replace placeholders locally in ignored .env; never commit credentials.
# FOGGY_SYNC_REPO=OWNER/PRIVATE_STATE_REPO
# FOGGY_SYNC_BRANCH=main
# FOGGY_SYNC_PATH=foggybrain/state.json
# FOGGY_SYNC_TOKEN=REPLACE_LOCALLY_WITH_DEDICATED_TOKEN
